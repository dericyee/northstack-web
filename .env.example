# Airtable — where website leads are written.
# Create a Personal Access Token at https://airtable.com/create/tokens
# with the scopes: data.records:write  (and access to the Northstack — Leads base)
AIRTABLE_API_KEY=your_personal_access_token_here

# These are pre-filled for the base Claude created. Change only if you move bases.
AIRTABLE_BASE_ID=appoQAyt0FaRRf9YM
AIRTABLE_TABLE_NAME=Leads

# Optional: also email yourself on each new lead (leave blank to skip).
# LEAD_NOTIFY_EMAIL=deric.yee@gmail.com
