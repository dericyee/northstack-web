# Airtable — where website leads are written.
# Create a Personal Access Token at https://airtable.com/create/tokens
# with the scopes: data.records:write  (and access to the Northstack — Leads base)

# Personal Access Token. Either name works; AIRTABLE_PAT_TOKEN is what the
# Vercel project uses.
AIRTABLE_PAT_TOKEN=your_personal_access_token_here
# AIRTABLE_API_KEY=your_personal_access_token_here   # legacy fallback name

# Base id for "Northstack — Leads". Either name works; AIRTABLE_BASE_TOKEN is
# what the Vercel project uses.
AIRTABLE_BASE_TOKEN=appoQAyt0FaRRf9YM
# AIRTABLE_BASE_ID=appoQAyt0FaRRf9YM                 # legacy fallback name

AIRTABLE_TABLE_NAME=Leads

# Optional: also email yourself on each new lead (leave blank to skip).
# LEAD_NOTIFY_EMAIL=deric.yee@gmail.com
